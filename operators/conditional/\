//condition?true_expression:false_expression
module conditional_code;

int c,d;
string y;
string a,b;
initial begin

  a = "true";
  b = "false";
  // Assign binary values to integers (interpreted as decimal)
  c = 4'b1001;
  d = 4'b0011;

  $display("\n \t the value of c is %0b",c);

  $display("\n \t the value of d is %0b",d);

  y=c>d?a:b;
  $display("\n \t the conditional output is %0b",y);
  $display("\n \t Because the c value is lessthan d values");
end
endmodule 
